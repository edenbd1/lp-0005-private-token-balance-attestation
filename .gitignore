# Rust
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# Risc0
.risc0/
*.bin

# Editors & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Env
.env
.env.local
*.local

# Node (for any GUI tooling)
node_modules/
dist/
build/

# Logs
*.log

# Demo artifacts (regenerable)
artifacts/
# ...except the deployed program binaries. These are the exact bytes that were
# submitted on chain: a LEZ deployment tx hash is SHA256(borsh(bytecode)), so
# anyone can recompute it from these files and match it against the deploy
# transactions in docs/DEPLOYMENT.md. Committing them also lets a reviewer, and
# CI, deploy and exercise the programs without a Docker risc0 rebuild.
!artifacts/programs/
!artifacts/programs/*.bin

# External repos cloned for recon (not part of submission)
_external/

app/build/
app/build-lgx/
app/lib/
VIDEO_SCRIPT.md
VIDEO_SCRIPT.pdf
